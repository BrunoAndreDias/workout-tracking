{
  "name": "workout-tracking",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "e2e": "node scripts/e2e.mjs",
    "check": "npm run typecheck && npm run lint && npm test && vite build && npm run perf:smoke && npm run e2e",
    "serve": "npm run build && node server/serve.ts",
    "dev-read": "HOST=0.0.0.0 npm run serve",
    "perf": "node scripts/perf.mjs",
    "perf:smoke": "node scripts/perf.mjs --no-build --no-write --runs 1 --weeks 2",
    "comments:ratchet": "node scripts/comment-ratchet.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
