{
  "name": "nutrition-tracking",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "import:portfir": "node scripts/import-portfir.ts",
    "import:usda": "node scripts/import-usda.ts",
    "derive:unsalted": "node scripts/derive-unsalted.ts",
    "build:equivalents": "node scripts/build-equivalents.ts",
    "check:equivalents": "node scripts/build-equivalents.ts --check",
    "e2e": "mkdir -p e2e/shots && node e2e/core-loop.mjs",
    "e2e:custom": "mkdir -p e2e/shots && node e2e/custom-food.mjs",
    "e2e:mobile": "mkdir -p e2e/shots && node e2e/mobile.mjs",
    "eval:search": "node scripts/search-eval.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
